# Contact form (server-only)
DISCORD_WEBHOOK_URL=<YOUR_DISCORD_WEBHOOK_URL>

# Discord login (public: copied into the browser bundle)
VITE_DISCORD_CLIENT_ID=<YOUR_DISCORD_CLIENT_ID>
VITE_DISCORD_REDIRECT_URI=<YOUR_DISCORD_REDIRECT_URI>

# Admin area (/admin). Leave VITE_ADMIN_DISCORD_ID empty to turn it off.
# Public on purpose: a Discord id is not a secret, the server re-checks the session on every request.
VITE_ADMIN_DISCORD_ID=<YOUR_DISCORD_USER_ID>
# Server-only from here on. Never prefix these with VITE_.
DISCORD_CLIENT_SECRET=<YOUR_DISCORD_CLIENT_SECRET>
# Signs the admin session cookie. Generate one: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=<RANDOM_32_BYTES>
# Fine-grained token: this repository only, permission "Contents: Read and write".
GITHUB_TOKEN=<YOUR_FINE_GRAINED_GITHUB_TOKEN>
GITHUB_REPO=<owner/repo>
# Branch the admin commits to; it must already exist on GitHub.
GITHUB_BRANCH=<branch>
